{%- comment -%}
  Real customer reviews only. Add one block per review you have permission to show
  (text + optional photo/screenshot), or add your reviews app block.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="page-width section--spaced">
    {%- if section.settings.heading != blank -%}
      <div class="section-head"><h2>{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="testimonials">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'review' -%}
            <div class="testimonial" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 200 | image_tag: class: 'testimonial__img', loading: 'lazy', alt: block.settings.name }}
              {%- endif -%}
              <div class="testimonial__body">
                {%- if block.settings.stars > 0 -%}
                  <div class="stars" aria-label="{{ 'accessibility.rating' | t: rating: block.settings.stars }}">
                    {%- for i in (1..5) -%}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{%- endfor -%}
                  </div>
                {%- endif -%}
                <p class="testimonial__quote">{{ block.settings.quote | escape }}</p>
                <span class="testimonial__who">
                  {{- block.settings.name | escape -}}
                  {%- if block.settings.product != blank %} · {{ block.settings.product.title | escape }}{% endif -%}
                </span>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "class": "section-testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "آراء عميلاتنا" },
    { "type": "paragraph", "content": "Add only real reviews from real customers." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "stars", "label": "Stars (0 = hide)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "Photo or WhatsApp screenshot" }
      ]
    }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}
