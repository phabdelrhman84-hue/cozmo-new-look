{%- comment -%}
  Related products rail for the product page.
  - First paint: products from the same collection (server-rendered, no layout jump).
  - Then: replaced with Shopify's dynamic recommendations for THIS product
    (Search & Discovery / intent=related) via the Section Rendering API.
  - Layout: one horizontal swipeable row (scroll-snap), arrows on desktop.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign heading = section.settings.heading
-%}

{%- if recommendations.performed? -%}
  {%- comment -%} AJAX response: only the rail items {%- endcomment -%}
  {%- if recommendations.products_count > 0 -%}
    <ul class="rail__track" role="list" data-cz-rail-track>
      {%- for rec in recommendations.products -%}
        <li class="rail__item">{% render 'product-card', product: rec %}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- else -%}
  {%- liquid
    assign source = product.collections.first.products
    if source == blank
      assign source = collections.all.products
    endif
  -%}
  <div
    class="page-width section--spaced rail"
    data-cz-related
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ section.settings.intent }}"
  >
    <div class="section-head rail__head">
      <div>
        <h2>{{ heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      <div class="rail__nav">
        <button type="button" class="rail__btn" data-cz-rail-prev aria-label="السابق">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <button type="button" class="rail__btn" data-cz-rail-next aria-label="التالي">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
      </div>
    </div>

    <div class="rail__viewport" data-cz-rail-viewport>
      <ul class="rail__track" role="list" data-cz-rail-track>
        {%- assign shown = 0 -%}
        {%- for item in source -%}
          {%- if item.id == product.id or item.available == false -%}{%- continue -%}{%- endif -%}
          <li class="rail__item">{% render 'product-card', product: item %}</li>
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      if (!root || !root.hasAttribute('data-cz-related')) return;
      var viewport = root.querySelector('[data-cz-rail-viewport]');
      var rtl = getComputedStyle(root).direction === 'rtl';

      function step(dir) {
        var item = viewport.querySelector('.rail__item');
        var w = item ? item.getBoundingClientRect().width + 12 : viewport.clientWidth * 0.8;
        var amount = Math.max(w, Math.floor(viewport.clientWidth / w) * w) * dir;
        viewport.scrollBy({ left: rtl ? -amount : amount, behavior: 'smooth' });
      }
      root.querySelector('[data-cz-rail-next]').addEventListener('click', function () { step(1); });
      root.querySelector('[data-cz-rail-prev]').addEventListener('click', function () { step(-1); });

      function load() {
        fetch(root.getAttribute('data-url'))
          .then(function (r) { return r.ok ? r.text() : ''; })
          .then(function (html) {
            if (!html) return;
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var fresh = doc.querySelector('[data-cz-rail-track]');
            if (fresh && fresh.children.length) {
              viewport.querySelector('[data-cz-rail-track]').replaceWith(fresh);
              viewport.scrollLeft = 0;
            }
          })
          .catch(function () {});
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (e) {
          if (e[0].isIntersecting) { io.disconnect(); load(); }
        }, { rootMargin: '400px' });
        io.observe(root);
      } else { load(); }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .rail__head { align-items: center; }
  .rail__nav { display: none; gap: 8px; }
  @media (min-width: 990px) { .rail__nav { display: flex; } }
  .rail__btn {
    width: 40px; height: 40px; border-radius: 50%;
    border: 1.5px solid var(--cz-beige-dark, #E8DFD5); background: #fff; color: var(--cz-text);
    display: flex; align-items: center; justify-content: center; transition: border-color .2s, color .2s;
  }
  .rail__btn:hover { border-color: var(--cz-primary); color: var(--cz-pink-text, #A35D78); }
  [dir="ltr"] .rail__btn svg { transform: scaleX(-1); }

  .rail__viewport {
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: 16px;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
    margin-inline: -16px; padding: 4px 16px 14px;
  }
  .rail__viewport::-webkit-scrollbar { display: none; }
  .rail__track {
    display: flex; gap: 12px; list-style: none; margin: 0; padding: 0;
    width: max-content; min-width: 100%;
  }
  .rail__item {
    flex: 0 0 auto; width: 44vw; max-width: 230px;
    scroll-snap-align: start; display: flex;
  }
  .rail__item > .card { width: 100%; }
  @media (min-width: 750px) {
    .rail__viewport { margin-inline: -32px; padding-inline: 32px; scroll-padding-inline: 32px; }
    .rail__item { width: 220px; }
  }
  @media (min-width: 990px) {
    .rail__track { gap: 20px; }
    .rail__item { width: calc((min(100vw, var(--cz-page-width, 1200px)) - 64px - 60px) / 4); max-width: 280px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related products",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "ممكن يعجبك كمان" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 4, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select", "id": "intent", "label": "Recommendation type", "default": "related",
      "options": [
        { "value": "related", "label": "Related (similar products)" },
        { "value": "complementary", "label": "Complementary (goes well with)" }
      ]
    }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
