<div class="page-width center-block">
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: width: 400 | image_tag: loading: 'eager', style: 'width:160px;height:auto', alt: shop.name }}
  {%- else -%}
    <h1>{{ shop.name }}</h1>
  {%- endif -%}
  <h2 style="font-size:22px">{{ 'general.password_title' | t }}</h2>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  <div class="form-card" style="width:100%">
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="Password">{{ 'general.password' | t }}</label>
        <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_enter' | t }}">
      </div>
      <button type="submit" class="btn btn--primary btn--block">{{ 'general.password_submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
