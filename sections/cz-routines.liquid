{%- liquid
  assign coll = section.settings.collection
-%}
<div class="page-width section--spaced">
  <div class="section-head">
    <div>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    {%- if coll != blank -%}<a href="{{ coll.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
  </div>
  <ul class="scroller" role="list">
    {%- if coll != blank -%}
      {%- for product in coll.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product, variant: 'routine' %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <li>
          <div class="card routine-card">
            <div class="card__media">{{ 'product-2' | placeholder_svg_tag }}</div>
            <div class="card__body"><div class="card__title">اختاري كولكشن الروتينات من إعدادات السكشن</div></div>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "Routines / bundles",
  "class": "section-routines",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "روتينات جاهزة بسعر أوفر" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "اخترناهم مع بعض عشان النتيجة تبان أسرع" },
    { "type": "collection", "id": "collection", "label": "Bundles collection", "info": "Put your routine/bundle products in one collection. Set a compare-at price to show the saving." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Routines / bundles" }]
}
{% endschema %}
