<div class="page-width section">
  <div class="hero-card">
    <div class="hero-card__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="hero-card__content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hero-card__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      <h1 class="hero-card__title">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_highlight != blank %} <em>{{ section.settings.heading_highlight | escape }}</em>{% endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="hero-card__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow', size: 20 %}
        </a>
      {%- endif -%}
      <div class="hero-card__ticks">
        {%- if section.settings.tick_1 != blank -%}<span>{% render 'icon', name: 'check', size: 14 %}{{ section.settings.tick_1 | escape }}</span>{%- endif -%}
        {%- if section.settings.tick_2 != blank -%}<span>{% render 'icon', name: 'check', size: 14 %}{{ section.settings.tick_2 | escape }}</span>{%- endif -%}
        {%- if section.settings.tick_3 != blank -%}<span>{% render 'icon', name: 'check', size: 14 %}{{ section.settings.tick_3 | escape }}</span>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero card",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape image, at least 1600px wide" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "روتين الترميم الألماني" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "شعرك تالف من الصبغة؟" },
    { "type": "text", "id": "heading_highlight", "label": "Heading (highlighted part)", "default": "رجّعيه من جوّه" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "منتجات أصلية مختارة بعين صيدلي، لكل مشكلة روتين واضح." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "اكتشفي روتينك" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Trust ticks" },
    { "type": "text", "id": "tick_1", "label": "Tick 1", "default": "أصلي 100%" },
    { "type": "text", "id": "tick_2", "label": "Tick 2", "default": "استرجاع 14 يوم" },
    { "type": "text", "id": "tick_3", "label": "Tick 3", "default": "دفع عند الاستلام" }
  ],
  "presets": [{ "name": "Hero card" }]
}
{% endschema %}
