{%- liquid
  assign number = settings.whatsapp_number | remove: '+' | remove: ' '
  assign msg = section.settings.message | default: settings.whatsapp_message
-%}
<div class="page-width section">
  <div class="pharm-card">
    <div style="display:flex;flex-direction:column;gap:8px">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- if number != blank -%}
      <a class="btn btn--light btn--lg" href="https://wa.me/{{ number }}?text={{ msg | url_encode }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp', size: 22 %}
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pharmacist WhatsApp",
  "class": "section-pharmacist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "محتارة تختاري إيه؟ اسألي الصيدلي" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "ابعتيلنا نوع شعرك أو بشرتك ومشكلتك، ونرشحلك روتين مناسب لميزانيتك." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "كلّمينا على واتساب" },
    { "type": "text", "id": "message", "label": "Prefilled message (optional)" },
    { "type": "paragraph", "content": "The WhatsApp number is set in Theme settings → Store & shipping." }
  ],
  "presets": [{ "name": "Pharmacist WhatsApp" }]
}
{% endschema %}
