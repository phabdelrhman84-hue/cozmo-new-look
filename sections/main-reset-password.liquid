<div class="page-width narrow" style="padding-block:24px 40px">
  <h1 class="page-title">{{ 'customer.reset' | t }}</h1>
  <div class="form-card">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.new_password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetConfirm">{{ 'customer.confirm_password' | t }}</label>
        <input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "class": "section-main-reset",
  "settings": []
}
{% endschema %}
