<div class="cart-drawer" data-cz-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cz-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div data-cz-cart-content style="display:flex;flex-direction:column;height:100%">
      <span data-cz-cart-state data-count="{{ cart.item_count }}" data-total="{{ cart.total_price }}" hidden></span>
      <div class="cart-drawer__head">
        <h2 id="CartDrawerTitle">{{ 'cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h2>
        <button type="button" class="icon-btn" data-cz-cart-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>

      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__body">
          <div class="cart-empty">
            {% render 'icon', name: 'bag-empty', size: 64 %}
            <strong>{{ 'cart.empty' | t }}</strong>
            <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
          </div>
        </div>
      {%- else -%}
        <div class="cart-drawer__body">
          {% render 'free-shipping-bar' %}
          {% render 'cart-line-items' %}
          {% render 'cart-upsell' %}
        </div>
        <div class="cart-drawer__foot">
          {% render 'cart-totals' %}
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--primary btn--lg btn--block">{{ 'cart.checkout' | t }}</button>
          </form>
          <p class="totals__note">{{ 'cart.cod_note' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
