<div class="page-width narrow" style="padding-block:24px 40px">
  <h1 class="page-title">{{ 'customer.register' | t }}</h1>
  <div class="form-card">
    {%- form 'create_customer' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="RegFirst">{{ 'customer.first_name' | t }}</label>
        <input id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="RegLast">{{ 'customer.last_name' | t }}</label>
        <input id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="RegEmail">{{ 'customer.email' | t }}</label>
        <input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="RegPassword">{{ 'customer.password' | t }}</label>
        <input id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.register' | t }}</button>
    {%- endform -%}
  </div>
  <p style="text-align:center;margin-top:16px"><a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a></p>
</div>

{% schema %}
{
  "name": "Register",
  "class": "section-main-register",
  "settings": []
}
{% endschema %}
