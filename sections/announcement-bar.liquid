{%- if section.blocks.size > 0 -%}
  <div class="announcement" {{ section.shopify_attributes }}>
    <div class="announcement__items">
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}<span class="announcement__sep" aria-hidden="true">·</span>{%- endunless -%}
        <span {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "الدفع عند الاستلام" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "شحن 75 ج.م لكل المحافظات" } },
        { "type": "announcement", "settings": { "text": "الدفع عند الاستلام" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
