{%- comment -%}
  Free shipping progress bar.
  Params:
    total: amount in cents already counted (default cart.total_price)
    live: true on the product page (JS recalculates with the selected offer)
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign counted = total | default: cart.total_price
  assign remaining = threshold | minus: counted
  if remaining < 0
    assign remaining = 0
  endif
  assign pct = 0
  if threshold > 0
    assign pct = counted | times: 100 | divided_by: threshold
  endif
  if pct > 100
    assign pct = 100
  endif
-%}
{%- if threshold > 0 -%}
  <div
    class="ship-bar{% if remaining == 0 %} is-complete{% endif %}"
    {% if live %}data-cz-ship-bar data-threshold="{{ threshold }}" data-cart-total="{{ cart.total_price }}"{% endif %}
  >
    <span class="ship-bar__text" data-ship-text>
      {%- if remaining == 0 -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- else -%}
        {%- capture amount -%}<strong>{{ remaining | money_without_trailing_zeros }}</strong>{%- endcapture -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: amount }}
      {%- endif -%}
    </span>
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
      <div class="ship-bar__fill" data-ship-fill style="width: {{ pct }}%"></div>
    </div>
  </div>
{%- endif -%}
