{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%}
  JSON-LD for search engines, rendered in <head>.
  - Home: Organization + WebSite (with sitelinks search box)
  - Product / collection: BreadcrumbList matching the visible breadcrumb
  Product data itself comes from `product | structured_data` in main-product.
{%- endcomment -%}
{%- liquid
  assign same_as = ''
  assign social_keys = 'social_instagram,social_facebook,social_tiktok' | split: ','
  for key in social_keys
    assign social_url = settings[key] | split: '?' | first | strip
    if social_url != blank
      assign same_as = same_as | append: social_url | append: '|'
    endif
  endfor
  assign same_as = same_as | split: '|'
-%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | strip | json }},
      "url": {{ request.origin | append: routes.root_url | json }}
      {%- if settings.logo != blank -%},
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
      {%- endif -%}
      {%- if same_as.size > 0 -%},
        "sameAs": {{ same_as | json }}
      {%- endif %}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | strip | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ request.origin }}{{ routes.search_url }}?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  {%- assign p_title = product.metafields.custom.short_title.value | default: product.title -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": {{ request.origin | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": "المنتجات", "item": {{ request.origin | append: routes.all_products_collection_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ p_title | strip_html | json }}, "item": {{ request.origin | append: product.url | json }} }
      ]
    }
  </script>
{%- elsif request.page_type == 'collection' and collection.handle != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": {{ request.origin | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | strip_html | json }}, "item": {{ request.origin | append: collection.url | json }} }
      ]
    }
  </script>
{%- endif -%}
