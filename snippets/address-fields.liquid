{%- comment -%} Address form fields. Params: form, prefix {%- endcomment -%}
{%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
<div class="field">
  <label for="AddrFirst-{{ prefix }}">{{ 'customer.first_name' | t }}</label>
  <input id="AddrFirst-{{ prefix }}" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
</div>
<div class="field">
  <label for="AddrLast-{{ prefix }}">{{ 'customer.last_name' | t }}</label>
  <input id="AddrLast-{{ prefix }}" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
</div>
<div class="field">
  <label for="AddrPhone-{{ prefix }}">{{ 'customer.phone' | t }}</label>
  <input id="AddrPhone-{{ prefix }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<div class="field">
  <label for="AddrA1-{{ prefix }}">{{ 'customer.address1' | t }}</label>
  <input id="AddrA1-{{ prefix }}" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label for="AddrA2-{{ prefix }}">{{ 'customer.address2' | t }}</label>
  <input id="AddrA2-{{ prefix }}" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="field">
  <label for="AddrCity-{{ prefix }}">{{ 'customer.city' | t }}</label>
  <input id="AddrCity-{{ prefix }}" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
</div>
<div class="field">
  <label for="AddrCountry-{{ prefix }}">{{ 'customer.country' | t }}</label>
  <select id="AddrCountry-{{ prefix }}" name="address[country]" autocomplete="country">
    {{ all_country_option_tags }}
  </select>
</div>
<div class="field">
  <label for="AddrProvince-{{ prefix }}">{{ 'customer.province' | t }}</label>
  <input id="AddrProvince-{{ prefix }}" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
</div>
<div class="field">
  <label for="AddrZip-{{ prefix }}">{{ 'customer.zip' | t }}</label>
  <input id="AddrZip-{{ prefix }}" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
</div>
<label style="display:flex;gap:8px;align-items:center;margin-bottom:14px;font-size:14px">
  {{ form.set_as_default_checkbox }} {{ 'customer.set_default' | t }}
</label>
