<style>
  @font-face { font-family: 'Alexandria'; src: url('{{ 'alexandria-var.woff2' | asset_url }}') format('woff2'); font-weight: 100 900; font-style: normal; font-display: swap; }
  @font-face { font-family: 'IBM Plex Sans Arabic'; src: url('{{ 'ibm-plex-arabic-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'IBM Plex Sans Arabic'; src: url('{{ 'ibm-plex-arabic-600.woff2' | asset_url }}') format('woff2'); font-weight: 500 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'IBM Plex Sans Arabic'; src: url('{{ 'ibm-plex-arabic-700.woff2' | asset_url }}') format('woff2'); font-weight: 700 800; font-style: normal; font-display: swap; }
  :root {
    --cz-primary: {{ settings.color_primary }};
    --cz-primary-hover: {{ settings.color_primary | color_darken: 8 }};
    --cz-accent: {{ settings.color_accent }};
    --cz-olive: {{ settings.color_olive }};
    --cz-olive-dark: {{ settings.color_olive | color_darken: 14 }};
    --cz-olive-soft: {{ settings.color_olive | color_mix: '#ffffff', 14 }};
    --cz-bg: {{ settings.color_background }};
    --cz-surface: #ffffff;
    --cz-blush: {{ settings.color_blush }};
    --cz-blush-soft: {{ settings.color_blush | color_mix: '#ffffff', 45 }};
    --cz-text: {{ settings.color_text }};
    --cz-text-muted: {{ settings.color_text | color_mix: settings.color_background, 75 }};
    --cz-text-subtle: {{ settings.color_text | color_mix: settings.color_background, 64 }};
    --cz-border: {{ settings.color_text | color_mix: settings.color_background, 9 }};
    --cz-border-strong: {{ settings.color_text | color_mix: settings.color_background, 16 }};
    --cz-strike: #8a8378;
    --cz-star: #b7832f;
    --cz-sale: {{ settings.color_sale }};
    --cz-radius-sm: 12px;
    --cz-radius-md: 16px;
    --cz-radius-lg: 22px;
    --cz-font-display: 'Alexandria', 'IBM Plex Sans Arabic', system-ui, sans-serif;
    --cz-font-body: 'IBM Plex Sans Arabic', system-ui, sans-serif;
    --cz-page-width: {{ settings.page_width }}px;
  }
</style>
